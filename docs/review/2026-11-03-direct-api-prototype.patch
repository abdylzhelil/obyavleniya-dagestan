+"""Read-only Direct API connection prototype. No campaign mutation endpoints."""
+import json
+import os
+import urllib.error
+import urllib.request
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+
+CAMPAIGN_ID = 715775801
+API_URL = 'https://api.direct.yandex.com/json/v501/campaigns'
+ROOT = Path(__file__).parent
+
+
+def probe():
+    token = os.environ.get('YANDEX_DIRECT_TOKEN', '')
+    headers = {'Content-Type': 'application/json; charset=utf-8', 'Accept-Language': 'ru'}
+    if token:
+        headers['Authorization'] = 'Bearer ' + token
+    payload = {'method': 'get', 'params': {
+        'SelectionCriteria': {'Ids': [CAMPAIGN_ID]},
+        'FieldNames': ['Id', 'Name', 'State', 'Status'],
+    }}
+    request = urllib.request.Request(API_URL, data=json.dumps(payload).encode(), headers=headers)
+    try:
+        with urllib.request.urlopen(request, timeout=25) as response:
+            status = response.status
+            body = json.loads(response.read(1048576))
+    except urllib.error.HTTPError as exc:
+        status = exc.code
+        try:
+            body = json.loads(exc.read(1048576))
+        except (ValueError, UnicodeError):
+            return {'status': 'http_error', 'http_status': status}
+    except (OSError, ValueError):
+        return {'status': 'connection_error', 'message': 'Проверка сети не завершилась. Данные кампаний не получены.'}
+    error = body.get('error')
+    if error:
+        # Do not echo raw response strings or headers that might contain credentials.
+        code = error.get('error_code')
+        return {'status': 'authorization_required' if code == 8000 and not token else 'api_error',
+                'http_status': status, 'api_error_code': code,
+                'message': 'OAuth-токен не указан' if code == 8000 and not token else 'API вернул ошибку. Изменений нет.',
+                'campaign_data_received': False}
+    campaigns = body.get('result', {}).get('Campaigns')
+    if not isinstance(campaigns, list):
+        return {'status': 'unexpected_response', 'http_status': status}
+    return {'status': 'read_complete', 'http_status': status,
+            'campaigns': [{k: c[k] for k in ('Id', 'Name', 'State', 'Status') if k in c}
+                          for c in campaigns if c.get('Id') == CAMPAIGN_ID]}
+
+
+class Handler(BaseHTTPRequestHandler):
+    def log_message(self, *args):
+        pass
+
+    def send(self, status, body, content_type):
+        self.send_response(status)
+        self.send_header('Content-Type', content_type)
+        self.send_header('Cache-Control', 'no-store')
+        self.send_header('X-Content-Type-Options', 'nosniff')
+        self.send_header('Content-Length', str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+    def do_GET(self):
+        if self.path != '/':
+            self.send(404, b'Not found', 'text/plain')
+            return
+        self.send(200, (ROOT / 'index.html').read_bytes(), 'text/html; charset=utf-8')
+
+    def do_POST(self):
+        if self.path != '/probe':
+            self.send(404, b'Not found', 'text/plain')
+            return
+        if self.headers.get('Origin') != 'http://127.0.0.1:8765':
+            self.send(403, b'Forbidden', 'text/plain')
+            return
+        self.send(200, json.dumps(probe(), ensure_ascii=False).encode(), 'application/json; charset=utf-8')
+
+
+if __name__ == '__main__':
+    print('Read-only prototype: http://127.0.0.1:8765', flush=True)
+    ThreadingHTTPServer(('127.0.0.1', 8765), Handler).serve_forever()
