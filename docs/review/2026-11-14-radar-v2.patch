+/* Shared ClientRadar demo: one visual language on home and product pages. */
+.kr-demo{--kr-line:#83cbd627;--kr-ink:#e5f3f6;box-sizing:border-box;isolation:isolate;width:100%;max-width:460px;min-width:0;border:1px solid var(--kr-line);border-radius:24px;background:linear-gradient(145deg,#102632,#081720 80%);box-shadow:0 24px 64px #020b1238,inset 0 1px #ffffff09;color:var(--kr-ink);font-family:inherit;overflow:hidden;text-align:left;}
+.kr-demo *{box-sizing:border-box;}
+.kr-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 20px;border-bottom:1px solid var(--kr-line);}
+.kr-brand{display:flex;gap:8px;align-items:center;font-size:12px;font-weight:600;letter-spacing:.01em;white-space:nowrap;}
+.kr-brand i,.kr-footer i{width:5px;height:5px;background:#94e5d4;border-radius:50%;display:inline-block;flex-shrink:0;}
+.kr-brand small{font-size:8px;font-weight:500;letter-spacing:.12em;color:#9cb5c0;border:1px solid #83cbd630;padding:3px 5px;border-radius:4px;}
+.kr-demo .kr-toggle{position:relative;z-index:2;min-width:62px;min-height:44px;margin:0;padding:7px 8px;border:0;border-radius:8px;background:transparent;color:#b6ced6;font:inherit;font-size:11px;cursor:pointer;}
+.kr-demo .kr-toggle:hover{color:#efffff;background:#82c7ca0d;}
+.kr-demo .kr-toggle:focus-visible{outline:2px solid #a5eddf;outline-offset:1px;}
+.kr-canvas{position:relative;padding:12px 20px 21px;overflow:hidden;background:radial-gradient(ellipse at 50% 34%,#246b7620,transparent 68%);}
+.kr-coordinate{font-size:8px;letter-spacing:.19em;color:#90adb9;text-align:center;padding-top:8px;}
+.kr-scope{display:block;width:min(100%,304px);height:auto;aspect-ratio:1;margin:0 auto;}
+.kr-scan{transform-origin:160px 160px;transform-box:view-box;}
+.kr-map-label{position:absolute;left:50%;top:52%;transform:translateX(-50%);font-size:7px;letter-spacing:.24em;color:#8fb4be99;pointer-events:none;}
+.kr-lead{position:relative;display:flex;align-items:center;gap:12px;max-width:350px;margin:-29px auto 0;padding:16px;border:1px solid #99d9dd3b;border-radius:14px;background:linear-gradient(120deg,#203d49f5,#132d39fa);box-shadow:0 12px 26px #020b1240,inset 0 1px #ffffff06;}
+.kr-lead-icon{width:36px;height:40px;display:grid;place-items:center;background:#83d8d40e;border:1px solid #83d8d41f;border-radius:10px;flex-shrink:0;}
+.kr-lead-icon svg{width:20px;height:20px;fill:none;stroke:#9be0d9;stroke-width:1.3;stroke-linecap:round;stroke-linejoin:round;}
+.kr-lead-copy{display:flex;flex-direction:column;min-width:0;gap:5px;}
+.kr-lead-copy small{font-size:9px;line-height:1.5;color:#a8c7cf;}
+.kr-lead-copy strong{font-size:14px;line-height:1.4;font-weight:600;color:#eef9fb;}
+.kr-lead-copy>span{font-size:10px;line-height:1.6;color:#b9cfd6;}
+.kr-check{margin-left:auto;align-self:flex-start;display:grid;place-items:center;min-width:19px;height:19px;border:1px solid #9be6d73d;background:#9be6d70a;border-radius:50%;font-size:11px;color:#b6eddf;}
+.kr-footer{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:14px 20px;border-top:1px solid var(--kr-line);font-size:9px;line-height:1.5;color:#b0cad2;}
+.kr-footer>span{display:flex;align-items:center;gap:7px;}
+.kr-footer small{font-size:8px;color:#88a5b1;white-space:nowrap;}
+/* Explicit longhands avoid the product page's global reduced-motion reset.
+   Play state remains independent so pause / hidden tab / offscreen work. */
+.kr-demo .kr-scan,.kr-demo .kr-target,.kr-demo .kr-echo,.kr-demo .kr-lead{animation-duration:12s!important;animation-iteration-count:infinite!important;animation-delay:0s!important;animation-direction:normal!important;animation-fill-mode:both!important;}
+.kr-demo .kr-scan{animation-name:krScan!important;animation-timing-function:linear!important;}
+.kr-demo .kr-target{animation-name:krTarget!important;animation-timing-function:ease-out!important;}
+.kr-demo .kr-echo{animation-name:krEcho!important;animation-timing-function:ease-out!important;transform-origin:251px 108px;transform-box:view-box;}
+.kr-demo .kr-lead{animation-name:krLead!important;animation-timing-function:ease-in-out!important;}
+.kr-demo.demo-motion-paused *{animation-play-state:paused!important;}
+@keyframes krScan{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
+@keyframes krTarget{0%,13%{opacity:.25}17%,27%{opacity:1}50%,100%{opacity:.35}}
+@keyframes krEcho{0%,15%{opacity:0;transform:scale(.65)}17%{opacity:.65;transform:scale(.8)}31%,100%{opacity:0;transform:scale(2.1)}}
+@keyframes krLead{0%,13%,100%{opacity:.55;transform:translateY(4px);border-color:#99d9dd26}22%,74%{opacity:1;transform:translateY(0);border-color:#99d9dd55}90%{opacity:.55;transform:translateY(4px);border-color:#99d9dd26}}
+@media(prefers-reduced-motion:reduce){.kr-demo:not(.demo-motion-enabled) .kr-scan,.kr-demo:not(.demo-motion-enabled) .kr-target,.kr-demo:not(.demo-motion-enabled) .kr-echo,.kr-demo:not(.demo-motion-enabled) .kr-lead{animation-name:none!important;}.kr-demo:not(.demo-motion-enabled) .kr-scan{transform:rotate(60deg)}.kr-demo:not(.demo-motion-enabled) .kr-echo{opacity:0}}
