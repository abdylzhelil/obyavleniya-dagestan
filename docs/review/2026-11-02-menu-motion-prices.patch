diff --git a/demo-motion.css b/demo-motion.css
new file mode 100644
index 0000000..626588e
--- /dev/null
+++ b/demo-motion.css
@@ -0,0 +1,26 @@
+/* Explanatory demos; no live lead data is shown. */
+.radar-demo{width:min(360px,100%);display:flex;flex-direction:column;align-items:center;gap:14px;color:#b3e8ff;--accent:#4cc3ff;}
+.radar-demo .radar{width:100%;max-width:340px;aspect-ratio:1;}
+.radar-demo .radar svg{display:block;width:100%;height:100%;overflow:visible;}
+.radar-demo .ring{fill:none;stroke:#70c9f6;stroke-width:.6;stroke-opacity:.3;}
+.radar-cross{fill:none;stroke:#70c9f6;stroke-width:.5;stroke-opacity:.22;}
+.radar-ticks{stroke:#7edbff;stroke-width:.75;stroke-opacity:.45;}
+.radar-demo .sweep{transform-box:view-box;transform-origin:100px 100px;animation:clientRadarSweep 8s linear infinite;}
+.radar-demo .rd-blip{fill:#c4f2ff;opacity:.2;animation:clientRadarHit 8s linear infinite;animation-delay:var(--hit);}
+.radar-demo .rd-ping{fill:none;stroke:#8ee1ff;stroke-width:1;opacity:0;transform-box:fill-box;transform-origin:center;animation:clientRadarPing 8s linear infinite;animation-delay:var(--hit);}
+@keyframes clientRadarSweep{from{transform:rotate(0deg);}to{transform:rotate(360deg);}}
+@keyframes clientRadarHit{0%,3%{opacity:1;}12%{opacity:.75;}40%,100%{opacity:.2;}}
+@keyframes clientRadarPing{0%{opacity:.9;transform:scale(1);}18%{opacity:0;transform:scale(3);}100%{opacity:0;transform:scale(3);}}
+.radar-demo .radar-demo-caption{font-size:12px;line-height:1.5;letter-spacing:.06em;text-align:center;color:#a1bac8;margin:0;}
+.motion-toggle{display:inline-flex;align-items:center;justify-content:center;min-height:44px;border:1px solid #9ac6bc50;border-radius:7px;background:transparent;color:#b8d4c8;padding:8px 12px;font:inherit;font-size:12px;cursor:pointer;}
+.motion-toggle:focus-visible{outline:3px solid #9cddff;outline-offset:3px;}
+.motion-toggle[hidden]{display:none;}
+.demo-motion-paused,.demo-motion-paused *,.demo-motion-paused::after,.demo-motion-paused *::after{animation-play-state:paused!important;}
+.rd-home .radar-demo-mini{align-self:center;width:100%;margin:4px auto;}
+.rd-home .radar-demo-mini .radar{max-width:220px;}
+.rd-home .bot-card>.motion-toggle{align-self:flex-start;}
+.rd-home .mini-feed{display:grid;}
+@media(prefers-reduced-motion:reduce){
+ .radar-demo .sweep,.radar-demo .rd-blip,.radar-demo .rd-ping{animation:none!important;}
+ .radar-demo .rd-blip{opacity:.85;}.radar-demo .rd-ping{opacity:0;}
+}
diff --git a/demo-motion.js b/demo-motion.js
new file mode 100644
index 0000000..c98ccf1
--- /dev/null
+++ b/demo-motion.js
@@ -0,0 +1,12 @@
+/* Pause decorative motion offscreen, in hidden tabs, or at the user's request. */
+(function(){
+ const reduce=window.matchMedia('(prefers-reduced-motion: reduce)');
+ const demos=[...document.querySelectorAll('[data-motion-demo]')].map(function(node){
+  return {node:node,button:document.querySelector('[data-motion-for="'+node.id+'"]'),visible:false,paused:false};
+ });
+ function update(d){d.node.classList.toggle('demo-motion-paused',!d.visible||d.paused||document.hidden||reduce.matches);if(d.button){d.button.hidden=reduce.matches;d.button.setAttribute('aria-pressed',String(d.paused));d.button.textContent=d.paused?'Продолжить анимацию':'Приостановить анимацию';}}
+ const io='IntersectionObserver' in window?new IntersectionObserver(function(entries){entries.forEach(function(e){const d=demos.find(x=>x.node===e.target);d.visible=e.isIntersecting;update(d);});},{threshold:.1}):null;
+ demos.forEach(function(d){if(d.button)d.button.addEventListener('click',function(){d.paused=!d.paused;update(d);});if(io)io.observe(d.node);else d.visible=true;update(d);});
+ document.addEventListener('visibilitychange',function(){demos.forEach(update);});
+ if(reduce.addEventListener)reduce.addEventListener('change',function(){demos.forEach(update);});
+})();
