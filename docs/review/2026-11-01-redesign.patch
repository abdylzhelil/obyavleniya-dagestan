--- /dev/null
+++ b/redesign.css
@@ -0,0 +1,152 @@
+/* Approved concept 1: photographic landscapes, quiet forest palette. */
+.rd-home,.rd-group{background:#081715;color:#f2f5ef;--ink:#f2f5ef;--ink-soft:#b5c3bd;--mint:#65d8b0;--glass-border:rgba(181,207,194,.2);background-image:none;}
+.rd-home::before,.rd-home::after,.rd-group::before,.rd-group::after{display:none;}
+.rd-home .wrap,.rd-group .wrap{max-width:1280px;width:calc(100% - 72px);}
+.rd-home header,.rd-group header{background:#081715ed;border-bottom:1px solid #c1dcc51a;box-shadow:none;backdrop-filter:blur(12px);}
+.rd-home .topbar,.rd-group .topbar{min-height:86px;gap:24px;}
+.rd-home .flag-stripe,.rd-group .flag-stripe{display:none;}
+.rd-home .logo-badge,.rd-group .logo-badge{width:58px;height:46px;background:none;border:0;box-shadow:none;border-radius:0;}
+.rd-home .logo-badge img,.rd-group .logo-badge img{width:58px;height:46px;border-radius:0;object-fit:contain;}
+.rd-home .brand,.rd-group .brand{max-width:185px;font-size:13px;line-height:1.35;letter-spacing:.06em;white-space:normal;}
+.rd-home .nav-links,.rd-group .nav-links{gap:30px;}
+.rd-home .nav-links>a,.rd-group .nav-links>a{font-size:13px;font-weight:500;}
+.rd-home section{padding:54px 0;}
+.rd-home h2,.rd-group h1{font-family:Georgia,'Times New Roman',serif;font-weight:600;letter-spacing:-.035em;line-height:1.1;}
+.rd-home h2{font-size:clamp(30px,3vw,44px);}
+.rd-home .eyebrow{color:#94b4a4;font-size:10px;letter-spacing:.2em;margin-bottom:12px;}
