new file mode 100644
index 0000000..afcb28c
--- /dev/null
+++ b/platform-prices.css
@@ -0,0 +1,23 @@
+/* Platform headings and names identify services independently of colour. */
+.platform-prices{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.3fr);align-items:start;gap:20px;margin:26px 0;}
+.platform-price-block{padding:24px;border:1px solid var(--platform-line);border-left:3px solid var(--platform-accent);border-radius:10px;background:var(--platform-bg);margin:24px 0;min-width:0;}
+.platform-telegram{--platform-accent:#84d4f4;--platform-line:#65bfdf52;--platform-bg:#0a2530;}
+.platform-whatsapp{--platform-accent:#91dfb8;--platform-line:#7bc59845;--platform-bg:#0a281e;}
+.platform-price-heading{display:flex;align-items:center;gap:12px;margin-bottom:18px;}
+.platform-price-heading h2,.platform-price-heading h3{margin:0;font:700 21px/1.35 Manrope,sans-serif;letter-spacing:0;color:var(--platform-accent);}
+.platform-price-icon{display:grid;place-items:center;flex-shrink:0;width:36px;height:36px;color:var(--platform-accent);border:1px solid var(--platform-line);border-radius:8px;}
+.platform-price-icon svg{width:22px;height:22px;}
+.platform-price-link{display:inline-flex;align-items:center;min-height:44px;font-size:13px;line-height:1.5;color:var(--platform-accent);text-decoration:underline;text-underline-offset:4px;}
+.rd-home #advertising .platform-price-block{padding:24px;margin:0;}
+.rd-home .platform-price-block .rd-ad-prices{margin:0 0 16px;}
+.platform-price-block .rd-ad-prices>div:first-child{padding-top:0;}
+.rd-home .platform-price-block .rd-ad-prices dt{font-size:15px;}
+.rd-home #advertising .platform-price-block p.rd-ad-extra{font-size:13px;line-height:1.7;margin:14px 0 0;color:#c4ddcf;}
+.rd-home #advertising .ad-contact-caption{font-size:13px;color:#bdd2c6;margin:20px 0 14px;}
+.platform-price-block .why-card{background:#ffffff05;box-shadow:none;border:1px solid var(--platform-line);border-radius:9px;}
+.platform-price-block .why-card::after{display:none;}
+.platform-price-block .ad-services{grid-template-columns:repeat(3,minmax(0,1fr));}
+.platform-telegram .ad-services{grid-template-columns:minmax(0,1fr);}
+.platform-price-block a:focus-visible{outline:3px solid var(--platform-accent);outline-offset:4px;}
+@media(max-width:1000px){.platform-prices{grid-template-columns:minmax(0,1fr);}.platform-price-block .ad-services{grid-template-columns:repeat(2,minmax(0,1fr));}.platform-telegram .ad-services{grid-template-columns:minmax(0,1fr);}}
+@media(max-width:600px){.platform-price-block,.rd-home #advertising .platform-price-block{padding:20px 16px;}.platform-price-heading h2,.platform-price-heading h3{font-size:19px;}.platform-price-block .ad-services{grid-template-columns:minmax(0,1fr);}.rd-home .platform-price-block .rd-ad-prices dt{font-size:14px;}.platform-price-block .rd-ad-prices dd{font-size:16px;}.rd-home #advertising .platform-prices{margin-top:22px;}}
